# Supabase Configuration
# Replace these with your Supabase Project URL and Anon Key from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Service role key for running node scripts/seed.js from terminal
# (Keep this private, do NOT put this in client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CR login credentials
VITE_CR_USERNAME=your-cr-username
VITE_CR_PASSWORD=replace-with-your-password
